config UART_HISILICON_V151
	bool "HISILICON V151 UART"
	default y
	depends on DT_HAS_HISILICON_V151_UART_ENABLED
	select SERIAL_HAS_DRIVER
	help
	  This option enables the UART driver for the HISILICON V151.
